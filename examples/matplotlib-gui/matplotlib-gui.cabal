Cabal-Version:  2.2
Name:           matplotlib-gui
Version:        0.1
Synopsis:       Small library providing tk-based GUI for matplotlib
Description:
  This library is for creating very simple GUI which could be interacted with
  from haskell side.


License:        BSD-3-Clause
License-File:   LICENSE
Author:         Aleksey Khudyakov <alexey.skladnoy@gmail.com>
Maintainer:     Aleksey Khudyakov <alexey.skladnoy@gmail.com>
Category:       Data
Build-Type:     Simple

Library
  Ghc-options:        -Wall -Werror=missing-methods -O2
  Default-Language:   GHC2021
  Default-Extensions: NoPolyKinds
                      --
                      DataKinds
                      DeriveAnyClass
                      DerivingStrategies
                      DerivingVia
                      LambdaCase
                      MultiWayIf
                      NegativeLiterals
                      PatternSynonyms
                      ViewPatterns
                      --
                      OverloadedRecordDot
                      NoFieldSelectors
                      DuplicateRecordFields
  --
  pkgconfig-depends: python3-embed
  hs-source-dirs:   src
  Build-Depends:    base         >=4.12 && <5
                  , inline-python
                  , text
                  , bytestring
                  , transformers
                  , async
                  , stm
                  , exceptions
                  , template-haskell
  Exposed-modules:
        Py.Matplotlib.GUI
        Py.Matplotlib
        Py.Extra

executable mpl-gui-test
  buildable: false
  --
  Default-Language: GHC2021
  main-is:          test.hs
  ghc-options:     -threaded
  Build-Depends:    base         >=4.12 && <5
                  , inline-python
                  , matplotlib-gui
